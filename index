      `<option value="${x.id}" ${x.id === s.tableId ? 'selected' : ''}>${esc(x.fileName)} — ${esc(x.sheetName)}</option>`
    ).join('');

    const ksVal = s.keySource === 'prev' ? 'prev' : 'src:' + (s.sourceCol || '');
    const srcOpts = srcHeaders.map(h =>
      `<option value="src:${esc(h)}" ${ksVal === 'src:' + h ? 'selected' : ''}>${esc(h)}</option>`
    ).join('');

    const keyOpts = cols.map(c =>
      `<option value="${esc(c)}" ${c === s.keyCol ? 'selected' : ''}>${esc(c)}</option>`
    ).join('');

    const retOpts = cols.map(c =>
      `<option value="${esc(c)}" ${c === s.returnCol ? 'selected' : ''}>${esc(c)}</option>`
    ).join('');

    const mode = s.matchMode || 'exact';

    return `
      <div class="step" data-id="${s.id}">
        <div class="step-top">
          <div class="step-num">${i + 1}</div>
          <div class="step-title">Langkah ${i + 1}</div>
          <button class="icon-btn sm danger" data-act="del-step" title="Hapus langkah">${icon('x')}</button>
        </div>
        <div class="step-fields">
          <label>Tabel tujuan
            <select data-field="tableId">
              <option value="">— pilih tabel —</option>
              ${tableOpts}
            </select>
          </label>
          <label>Nilai kunci berasal dari
            <select data-field="keySource">
              <option value="prev" ${ksVal === 'prev' ? 'selected' : ''}>← Hasil langkah sebelumnya</option>
              <optgroup label="Kolom tabel sumber">
                ${srcOpts || '<option value="" disabled>(tabel sumber belum dipilih)</option>'}
              </optgroup>
            </select>
          </label>
          <label>Kolom kunci di tabel tujuan
            <select data-field="keyCol" ${cols.length ? '' : 'disabled'}>
              ${keyOpts || '<option value="">(—)</option>'}
            </select>
          </label>
          <label>Mode pencocokan
            <select data-field="matchMode">
              <option value="exact" ${mode === 'exact' ? 'selected' : ''}>Persis (sama)</option>
              <option value="contains" ${mode === 'contains' ? 'selected' : ''}>Kunci mengandung nilai</option>
              <option value="within" ${mode === 'within' ? 'selected' : ''}>Nilai mengandung kunci</option>
            </select>
          </label>
          <label>Kolom yang diambil
            <select data-field="returnCol" ${cols.length ? '' : 'disabled'}>

  $('#statSteps').textContent = state.steps.length;
  $('#statStepsSub').textContent = state.steps.length ? 'Langkah rantai aktif' : 'Belum ada langkah';

  if (r && r.total){
    const pct = Math.round(r.fullMatch / r.total * 100);
    const tone = pct >= 100 ? 'badge-success' : pct > 0 ? 'badge-warning' : 'badge-danger';
    $('#statMatch').textContent = pct + '%';

   12. RENDER ALL
   ========================================================= */
function renderAll(){
  renderStats();
  renderTables();
  renderChain();
}

/* =========================================================
   13. EVENT BINDING
   ========================================================= */

/* --- upload --- */
$('#fileInput').addEventListener('change', e => {
  if (e.target.files.length) handleFiles(e.target.files);
  e.target.value = '';
});

/* --- drag & drop global --- */
let dragDepth = 0;
window.addEventListener('dragenter', e => {
  e.preventDefault();
  dragDepth++;
  document.body.classList.add('dragging');
});
window.addEventListener('dragover', e => e.preventDefault());
window.addEventListener('dragleave', e => {
  e.preventDefault();
  dragDepth = Math.max(0, dragDepth - 1);
  if (!dragDepth) document.body.classList.remove('dragging');
});
window.addEventListener('drop', e => {
  e.preventDefault();
  dragDepth = 0;
  document.body.classList.remove('dragging');
  if (e.dataTransfer && e.dataTransfer.files.length) handleFiles(e.dataTransfer.files);
});

/* --- daftar tabel --- */
$('#tablesList').addEventListener('click', e => {
  const item = e.target.closest('.table-item');
  if (!item) return;
  const id = item.dataset.id;
  const actEl = e.target.closest('[data-act]');
  const act = actEl ? actEl.dataset.act : null;

  if (act === 'preview'){ openPreview(id); return; }

  if (act === 'remove'){
    state.tables = state.tables.filter(t => t.id !== id);
    state.steps.forEach(s => {
      if (s.tableId === id){
        s.tableId = '';
        s.keyCol = '';
        s.returnCol = '';
      }
    });
    if (state.sourceTableId === id){
      const first = state.tables[0];
      state.sourceTableId = first ? first.id : '';
    }
    syncSourceCols();
    state.result = null;
    renderAll(); renderResult();
    return;
  }

  state.sourceTableId = id;
  syncSourceCols();
  renderAll();
});

/* --- sumber --- */
$('#sourceTable').addEventListener('change', e => {
  state.sourceTableId = e.target.value;
  syncSourceCols();
  renderAll();
});

/* --- pencarian tabel --- */
$('#tableSearch').addEventListener('input', e => {
  state.tableFilter = e.target.value;
  renderTables();
});

/* --- tambah langkah --- */
$('#btnAddStep').addEventListener('click', () => {
  const src = getTable(state.sourceTableId);
  const isFirst = state.steps.length === 0;
  state.steps.push({
    id: nid('step'),
    tableId: '',
    keySource: isFirst ? 'source' : 'prev',
    sourceCol: isFirst && src ? (src.headers[0] || '') : '',
    keyCol: '',
    returnCol: '',
    matchMode: 'exact',
    alias: ''
  });
  renderStats();
  renderSteps();
});

/* --- perubahan field pada langkah --- */
$('#steps').addEventListener('change', e => {
  const stepEl = e.target.closest('.step');
  if (!stepEl) return;
  const step = state.steps.find(s => s.id === stepEl.dataset.id);
  if (!step) return;

  const field = e.target.dataset.field;

  if (field === 'tableId'){
    step.tableId = e.target.value;
    const t = getTable(step.tableId);
    step.keyCol = t ? (t.headers[0] || '') : '';
    step.returnCol = t ? (t.headers[1] || t.headers[0] || '') : '';
    renderSteps();
    return;
  }

  if (field === 'keySource'){
    const v = e.target.value;
    if (v === 'prev'){
      step.keySource = 'prev';
      step.sourceCol = '';
    } else if (v.startsWith('src:')){
      step.keySource = 'source';
      step.sourceCol = v.slice(4);
    }
    return;
  }

  step[field] = e.target.value;
});

/* --- alias (input) --- */
$('#steps').addEventListener('input', e => {
  if (e.target.dataset.field !== 'alias') return;
  const stepEl = e.target.closest('.step');
  const step = state.steps.find(s => s.id === stepEl.dataset.id);
  if (step) step.alias = e.target.value;
});

/* --- hapus langkah --- */
$('#steps').addEventListener('click', e => {
  if (!e.target.closest('[data-act="del-step"]')) return;
  const stepEl = e.target.closest('.step');
  state.steps = state.steps.filter(s => s.id !== stepEl.dataset.id);
  renderStats();
  renderSteps();
});

/* --- aksi hasil --- */
$('#btnRun').addEventListener('click', runChain);
$('#btnCSV').addEventListener('click', exportCSV);
$('#btnXLSX').addEventListener('click', exportExcel);

$('#displayLimit').addEventListener('change', e => {
  state.displayLimit = Number(e.target.value);
  renderResult();
});

/* --- modal --- */
$('#modalClose').addEventListener('click', () => $('#modal').classList.remove('open'));
$('#modal').addEventListener('click', e => {
  if (e.target.id === 'modal') $('#modal').classList.remove('open');
});
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') $('#modal').classList.remove('open');
});

/* --- reset --- */
$('#btnReset').addEventListener('click', () => {
  if (state.tables.length && !confirm('Hapus semua data yang dimuat?')) return;
  state.tables = [];
  state.steps = [];
  state.sourceTableId = '';
  state.result = null;
  state.tableFilter = '';
  $('#tableSearch').value = '';
  renderAll();
  renderResult();
});

/* =========================================================
   14. INIT
   ========================================================= */
hydrateIcons();
renderAll();
renderResult();
</script>
</body>
</html>

function renderSteps(){
  const el = $('#steps');

  if (!state.steps.length){
    el.innerHTML = `<div class="empty small">Belum ada langkah lookup.<br>Klik <b>＋ Tambah Langkah</b> untuk memulai rantai.</div>`;

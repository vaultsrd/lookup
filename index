          </label>
        </div>
      </div>
    `;
  }).join('');
}

/* =========================================================
   8. MESIN CHAIN LOOKUP
   ========================================================= */
function findValue(step, searchVal){
  const k = normKey(searchVal);
  if (k === '') return undefined;

  if (step.matchMode === 'exact'){
    return step.map.has(k) ? step.map.get(k) : undefined;
  }
  for (const item of step.list){
    if (step.matchMode === 'contains'){
      if (item.k.includes(k)) return item.v;
    } else {
      if (k.includes(item.k)) return item.v;
    }
  }
  return undefined;
}

function runChain(){
  const src = getTable(state.sourceTableId);
  if (!src) return toast('Pilih tabel sumber terlebih dahulu.');
  if (!state.steps.length) return toast('Tambahkan minimal satu langkah lookup.');

  for (let i = 0; i < state.steps.length; i++){
    const s = state.steps[i];
    if (!s.tableId) return toast(`Langkah ${i+1}: pilih tabel tujuan.`);
    if (s.keySource === 'source' && !s.sourceCol)
      return toast(`Langkah ${i+1}: pilih kolom sumber.`);
    if (s.keySource === 'prev' && i === 0)
      return toast(`Langkah 1 tidak bisa memakai "hasil langkah sebelumnya".`);
    if (!s.keyCol) return toast(`Langkah ${i+1}: pilih kolom kunci di tabel tujuan.`);
    if (!s.returnCol) return toast(`Langkah ${i+1}: pilih kolom yang diambil.`);
  }

  const prepared = state.steps.map(s => {
    const t = getTable(s.tableId);
    const map = new Map();
    const list = [];

    for (const row of t.rows){
      const k = normKey(row[s.keyCol]);
      if (k === '') continue;
      if (s.matchMode === 'exact'){
        if (!map.has(k)) map.set(k, row[s.returnCol]);
      } else {
        list.push({ k, v: row[s.returnCol] });
      }
    }

    if (s.matchMode === 'contains'){
      list.sort((a, b) => a.k.length - b.k.length);
    } else if (s.matchMode === 'within'){
      list.sort((a, b) => b.k.length - a.k.length);
    }

    return { ...s, table: t, map, list, matchCount: 0 };
  });

  const used = new Set(src.headers);
  const aliases = prepared.map((s) => {
    const base = (s.alias || '').trim() || `${s.returnCol} [${s.table.sheetName}]`;
    return uniqueName(base, used);
  });
  const headers = [...src.headers, ...aliases];

  const rows = [];
  let fullMatch = 0;

  for (const row of src.rows){
    const out = {};
    src.headers.forEach(h => { out[h] = row[h]; });

    const stepValues = [];
    let allMatched = true;

    prepared.forEach((step, i) => {
      let searchVal = null;
      let canRun = false;

      if (step.keySource === 'prev'){
        if (i > 0){
          searchVal = stepValues[i - 1];
          canRun = searchVal !== null && searchVal !== undefined && normKey(searchVal) !== '';
        }
      } else {
        searchVal = row[step.sourceCol];
        canRun = true;
      }

      let val = null;
      if (canRun && normKey(searchVal) !== ''){
        const found = findValue(step, searchVal);
        if (found !== undefined){
          val = found;
          step.matchCount++;
        }
      }
      if (val === null || val === undefined) allMatched = false;

      stepValues.push(val);
      out[aliases[i]] = val;
    });

    if (allMatched) fullMatch++;
    rows.push(out);
  }

  const stepStats = prepared.map((s, i) => ({
    index: i,
    label: s.alias || `${s.returnCol} [${s.table.sheetName}]`,
    matched: s.matchCount
  }));

  state.result = { headers, rows, total: src.rows.length, fullMatch, stepStats };

  renderStats();
  renderResult();

  if (!rows.length) toast('Tabel sumber tidak memiliki baris data.');
  else toast(`Selesai: ${fullMatch}/${rows.length} baris cocok penuh.`);
}

/* =========================================================
   9. RENDER HASIL
   ========================================================= */
function tableHTML(headers, rows, withNum){
  if (!headers.length) return `<div class="empty">Tidak ada kolom.</div>`;

  const head = headers.map(h => `<th>${esc(h)}</th>`).join('');
  const body = rows.map((r, i) => {
    const cells = headers.map(h => `<td>${esc(fmt(r[h]))}</td>`).join('');
    return `<tr>${withNum ? `<td class="rownum">${i + 1}</td>` : ''}${cells}</tr>`;
  }).join('');

  return `<div class="table-wrap"><table>
    <thead><tr>${withNum ? '<th class="rownum">#</th>' : ''}${head}</tr></thead>
    <tbody>${body}</tbody>
  </table></div>`;
}

function renderResult(){
  const area = $('#resultArea');

  if (!state.result){
    area.innerHTML = `<div class="empty">Belum ada hasil.<br>Atur sumber &amp; langkah, lalu klik <b>Jalankan Lookup</b>.</div>`;
    return;
  }

  const { headers, rows, total, fullMatch, stepStats } = state.result;
  const limit = state.displayLimit;
  const shown = limit === 0 ? rows.length : Math.min(limit, rows.length);
  const pct = total ? Math.round(fullMatch / total * 100) : 0;

  area.innerHTML = `
    <div class="stats">
      <span class="badge badge-muted">${total} baris sumber</span>
      <span class="badge badge-success">${fullMatch} cocok penuh (${pct}%)</span>
      <span class="badge badge-warning">${total - fullMatch} tidak lengkap</span>
      <span class="badge badge-primary">${headers.length} kolom output</span>
    </div>
    ${stepStats && stepStats.length ? `
      <div class="step-stats">
        ${stepStats.map(s => `
          <span class="badge badge-info">Langkah ${s.index + 1} · ${esc(s.label)}: ${s.matched}/${total}</span>
        `).join('')}
      </div>` : ''}
    ${tableHTML(headers, rows.slice(0, shown), true)}
    ${shown < rows.length
      ? `<p class="hint" style="margin:10px 0 0">Menampilkan ${shown} dari ${rows.length} baris — file ekspor tetap berisi seluruh baris.</p>`
      : ''}
  `;
}

/* =========================================================
   10. EXPORT
   ========================================================= */
function csvCell(v){
  const s = fmt(v);
  return /[",\n\r;]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
}

function exportCSV(){
  if (!state.result) return toast('Belum ada hasil untuk diekspor.');
  const { headers, rows } = state.result;
  const lines = [headers.map(csvCell).join(',')];
  rows.forEach(r => lines.push(headers.map(h => csvCell(r[h])).join(',')));

  const blob = new Blob(['\uFEFF' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
  download(blob, `chain-lookup-${stamp()}.csv`);
  toast('CSV berhasil diunduh.');
}

function exportExcel(){
  if (!state.result) return toast('Belum ada hasil untuk diekspor.');
  const { headers, rows } = state.result;

  const aoa = [headers, ...rows.map(r => headers.map(h => {
    const v = r[h];
    if (v === null || v === undefined) return '';
    return v;
  }))];

  const ws = XLSX.utils.aoa_to_sheet(aoa);
  ws['!cols'] = headers.map(h => ({ wch: Math.min(40, Math.max(12, h.length + 4)) }));

  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Hasil');
  XLSX.writeFile(wb, `chain-lookup-${stamp()}.xlsx`);
  toast('Excel berhasil diunduh.');
}

/* =========================================================
   11. PREVIEW MODAL
   ========================================================= */
function openPreview(id){
  const t = getTable(id);
  if (!t) return;
  $('#modalTitle').textContent = `${t.fileName} — ${t.sheetName}  (${t.rows.length} baris)`;
  $('#modalBody').innerHTML = tableHTML(t.headers, t.rows.slice(0, 300), true) +
    (t.rows.length > 300
      ? `<p class="hint" style="margin:12px 0 0">Pratinjau 300 baris pertama dari ${t.rows.length} baris.</p>`
      : '');
  $('#modal').classList.add('open');
}


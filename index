function icon(name, cls){
  const path = ICONS[name] || '';
  return `<svg class="ico ${cls || ''}" viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${path}</svg>`;
}

function hydrateIcons(root){
  (root || document).querySelectorAll('[data-ico]').forEach(el => {
    if (el.dataset.icoDone) return;
    el.innerHTML = icon(el.dataset.ico, el.dataset.icoClass || '');
    el.dataset.icoDone = '1';
  });
}

/* =========================================================
   1. STATE
   ========================================================= */
let uidCounter = 0;
const nid = p => `${p}_${++uidCounter}`;

const state = {
  tables: [],          // { id, fileName, sheetName, headers[], rows[] }
  sourceTableId: '',
  steps: [],           // { id, tableId, keySource, sourceCol, keyCol, returnCol, alias, matchMode }
  result: null,        // { headers, rows, total, fullMatch, stepStats[] }
  displayLimit: 500,
  tableFilter: ''
};

/* =========================================================
   2. UTILITAS
   ========================================================= */
const $ = sel => document.querySelector(sel);

const esc = s => String(s ?? '').replace(/[&<>"']/g,
  c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

function fmt(v){
  if (v === null || v === undefined || v === '') return '';
  if (v instanceof Date){
    const p = n => String(n).padStart(2,'0');
    return `${v.getFullYear()}-${p(v.getMonth()+1)}-${p(v.getDate())}`;
  }
  return String(v);
}

function normKey(v){
  if (v === null || v === undefined) return '';
  if (v instanceof Date) return String(v.getTime());
  return String(v).replace(/\s+/g,' ').trim().toLowerCase();
}

const getTable = id => state.tables.find(t => t.id === id);

let toastTimer;
function toast(msg){
  const el = $('#toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('show'), 2800);
}

function uniqueName(base, used){
  let name = base, i = 2;
  while (used.has(name)) name = `${base} (${i++})`;
  used.add(name);
  return name;
}

function stamp(){
  const d = new Date(), p = n => String(n).padStart(2,'0');
  return `${d.getFullYear()}${p(d.getMonth()+1)}${p(d.getDate())}-${p(d.getHours())}${p(d.getMinutes())}`;
}

function download(blob, filename){
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename; a.click();
  setTimeout(() => URL.revokeObjectURL(url), 1500);
}

/* =========================================================
   3. PARSING FILE EXCEL / CSV
   ========================================================= */
function buildTable(fileName, sheetName, aoa){
  const rows = aoa.filter(r => Array.isArray(r) &&
    r.some(c => c !== null && c !== undefined && c !== ''));

  if (!rows.length) return null;

  const headerRow = rows[0];
  const maxCols = rows.reduce((m, r) => Math.max(m, r.length), 0);

  const headers = [];
  const counter = new Map();
  for (let i = 0; i < maxCols; i++){
    let h = String(headerRow[i] ?? '').trim() || `Kolom ${i+1}`;
    const c = counter.get(h) || 0;
    counter.set(h, c + 1);
    if (c > 0) h = `${h} (${c + 1})`;
    headers.push(h);
  }

  const data = [];
  for (let i = 1; i < rows.length; i++){
    const obj = {};
    headers.forEach((h, idx) => { obj[h] = rows[i][idx] ?? null; });
    data.push(obj);
  }

  return { id: nid('tbl'), fileName, sheetName, headers, rows: data };
}

async function handleFiles(fileList){
  const files = Array.from(fileList).filter(f => /\.(xlsx|xls|xlsm|csv)$/i.test(f.name));
  if (!files.length){ toast('Format file tidak didukung.'); return; }

  let added = 0;

  for (const file of files){
    try {
      const buf = await file.arrayBuffer();
      const wb = XLSX.read(buf, { type: 'array', cellDates: true });

      wb.SheetNames.forEach(sheetName => {
        const ws = wb.Sheets[sheetName];
        const aoa = XLSX.utils.sheet_to_json(ws, {
          header: 1, defval: null, raw: true, blankrows: false
        });
        const tbl = buildTable(file.name, sheetName, aoa);
        if (tbl){ state.tables.push(tbl); added++; }
      });
    } catch (err){
      console.error(err);
      toast(`Gagal membaca "${file.name}"`);
    }
  }

  if (added){
    if (!state.sourceTableId || !getTable(state.sourceTableId)){
      state.sourceTableId = state.tables[0].id;
    }
    syncSourceCols();
    state.result = null;
    renderAll();
    renderResult();
    toast(`${added} tabel berhasil dimuat.`);
  } else {
    toast('Tidak ada data yang bisa dibaca.');
  }
}

/* =========================================================
   4. SINKRONISASI KOLOM SUMBER → STEP
   ========================================================= */
function syncSourceCols(){
  const src = getTable(state.sourceTableId);
  const headers = src ? src.headers : [];
  state.steps.forEach(s => {
    if (s.keySource === 'source'){
      if (!headers.includes(s.sourceCol)) s.sourceCol = headers[0] || '';
    }
  });
}

